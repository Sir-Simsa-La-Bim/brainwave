def literals() -> ()
{
    entry {
        data <= (
            256,
            u24(0x123456),
            i16(-2),
            float16(nan),
            float32(1.5),
            float64(-inf),
            ascii('OK'),
            utf8("Gr\u00FCezi"),
            ?,
        );
    }
    code { goto(data); }
    exit { data => preserved; }
}
